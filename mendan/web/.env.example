# ===== Web（ブラウザ）の設定 =====
# Firebase コンソール →「プロジェクトの設定」→「マイアプリ」のウェブアプリの値を貼り付けます。
# ※ これらはブラウザに公開される前提の識別子です（APIキーではなく Firebase のプロジェクト識別用）。
#    Gemini / Claude のAPIキーは絶対にここへ書かないでください（サーバーの Secret Manager に保存します）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# ログイン画面で候補に出す Google Workspace ドメイン（例: example.com）
VITE_ALLOWED_DOMAIN=
# ローカル開発でエミュレーターに接続する場合 true
VITE_USE_EMULATORS=false
