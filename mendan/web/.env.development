# `npm run dev` の既定値（エミュレーター接続）。本番の値は .env.local / .env.production に書く。
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-souzoku-mendan
VITE_FIREBASE_STORAGE_BUCKET=demo-souzoku-mendan.appspot.com
VITE_FIREBASE_APP_ID=demo
VITE_ALLOWED_DOMAIN=example.com
VITE_USE_EMULATORS=true
